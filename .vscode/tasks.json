{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/src/Fanex.AFF12B.CronJobs.WebHost/Fanex.AFF12B.CronJobs.WebHost.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/src/Fanex.AFF12B.CronJobs.WebHost/Fanex.AFF12B.CronJobs.WebHost.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/Fanex.AFF12B.CronJobs.WebHost/Fanex.AFF12B.CronJobs.WebHost.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "generate coverage report",
            "command": "reportgenerator",
            "type": "shell",
            "args": [
                "-reports:${workspaceFolder}/src/TestResults/coverage.opencover.xml",
                "-targetdir:${workspaceFolder}/src/TestResults/coveragereport"
            ],
            "problemMatcher": []
        }
    ]
}